.DS_Store
node_modules/
*.log

# generated icon/screenshot output is intentionally committed,
# but these scratch dirs are not
.design-scratch/
tmp/

# scratch: launch prototypes, not shipped
launch/

# vercel CLI local state
.vercel
.env*

# Brand PNGs are generated by scripts/brand.mjs. Only the renditions the
# web actually serves are committed, so the apple-touch-icon and the web
# manifest cannot 404 on a fresh clone or on Vercel. Note the bare `/*`:
# git cannot re-include a file inside an excluded directory.
assets/generated/logo/*
!assets/generated/logo/design-storyboard-ink-32.png
!assets/generated/logo/design-storyboard-ink-180.png
!assets/generated/logo/design-storyboard-ink-512.png
